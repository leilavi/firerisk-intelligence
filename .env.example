# Copy to .env and fill in. Never commit .env.
MODEL_API_KEY=your-meta-model-api-key-here
# Optional overrides
META_API_BASE_URL=https://api.meta.ai/v1
META_REASONING_MODEL=muse-spark-1.3
# Google Drive automatic updates (written by setup_drive_sync.bat)
FIRERISK_DRIVE_EXPORT_URL=
FIRERISK_DRIVE_TOKEN=
FIRERISK_SYNC_MINUTES=30
# Automatic Muse Spark analysis of fire-risk alerts
FIRERISK_AUTO_AI=1
FIRERISK_AI_MIN_LEVEL=watch
FIRERISK_AI_DAILY_LIMIT=20
# Survey videos from Google Drive
FIRERISK_DRIVE_VIDEOS=1
FIRERISK_AUTO_VIDEO_AI=1
FIRERISK_VIDEO_AI_DAILY_LIMIT=8
